{
  "name": "@rivet/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "dev": "node ../../scripts/desktop.mjs",
    "package": "electron-builder --dir",
    "prepackage": "node -e \"require('electron')\""
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.rivet.desktop",
    "productName": "Rivet",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "src/**",
      "package.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../packages/github/src/oauth.cjs",
        "to": "oauth.cjs"
      },
      {
        "from": "../../github-oauth.json",
        "to": "github-oauth.json"
      }
    ],
    "electronVersion": "45.2.3",
    "electronDist": "../../node_modules/electron/dist",
    "executableName": "rivet",
    "icon": "assets/icon.png"
  },
  "description": "Rivet, a focused GitHub client for desktop.",
  "productName": "Rivet"
}
